rules_version = '2';

// Assumed data model:
// users/{uid}/appState/current
//   payload: string, required, serialized Chronos Flow state, maximum 700,000
//            characters. Contains preferences, events, tasks, and scratchpad.
//   updatedAt: timestamp, required, set by the server with serverTimestamp().
//
// Each signed-in user may read and write only their own single state document.
// The payload is opaque to rules, so the rules constrain its type and size;
// application data remains private by user path and is validated by the app.

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function isValidAppState(data) {
      return data.keys().hasAll(['payload', 'updatedAt']) &&
        data.keys().hasOnly(['payload', 'updatedAt']) &&
        data.payload is string &&
        data.payload.size() <= 700000 &&
        data.updatedAt == request.time;
    }

    match /users/{uid}/appState/{documentId} {
      allow get: if isOwner(uid) && documentId == 'current';
      allow list: if false;
      allow create: if isOwner(uid) &&
        documentId == 'current' &&
        uidUnchanged() &&
        isValidAppState(request.resource.data);
      allow update: if isOwner(uid) &&
        documentId == 'current' &&
        uidNotModified() &&
        isValidAppState(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

